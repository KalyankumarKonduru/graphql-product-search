scalar DateTime

type Product {
  id: ID!
  name: String!
  description: String!
  price: Float!
  category: Category!
  imageUrl: String!
  stock: Int!
  rating: Float!
  reviewCount: Int!
  createdAt: DateTime!
  updatedAt: DateTime!
}

type Category {
  id: ID!
  name: String!
  slug: String!
  productCount: Int!
}

type Review {
  id: ID!
  productId: ID!
  userId: String!
  userName: String!
  rating: Int!
  comment: String!
  createdAt: DateTime!
}

type PageInfo {
  hasNextPage: Boolean!
  hasPreviousPage: Boolean!
  startCursor: String
  endCursor: String
  totalCount: Int!
}

type ProductEdge {
  cursor: String!
  node: Product!
}

type ProductConnection {
  edges: [ProductEdge!]!
  pageInfo: PageInfo!
}

type ReviewEdge {
  cursor: String!
  node: Review!
}

type ReviewConnection {
  edges: [ReviewEdge!]!
  pageInfo: PageInfo!
}

input ProductFilterInput {
  search: String
  categoryId: ID
  minPrice: Float
  maxPrice: Float
  minRating: Float
  inStock: Boolean
}

input ProductSortInput {
  field: ProductSortField!
  order: SortOrder!
}

enum ProductSortField {
  NAME
  PRICE
  RATING
  CREATED_AT
}

enum SortOrder {
  ASC
  DESC
}

input CreateProductInput {
  name: String!
  description: String!
  price: Float!
  categoryId: ID!
  imageUrl: String!
  stock: Int!
}

input UpdateProductInput {
  name: String
  description: String
  price: Float
  categoryId: ID
  imageUrl: String
  stock: Int
}

input CreateReviewInput {
  productId: ID!
  rating: Int!
  comment: String!
}

type Query {
  product(id: ID!): Product
  products(
    first: Int
    after: String
    last: Int
    before: String
    filter: ProductFilterInput
    sort: ProductSortInput
  ): ProductConnection!
  categories: [Category!]!
  category(id: ID!): Category
  reviews(productId: ID!, first: Int, after: String): ReviewConnection!
  searchSuggestions(query: String!, limit: Int): [String!]!
}

type Mutation {
  createProduct(input: CreateProductInput!): Product!
  updateProduct(id: ID!, input: UpdateProductInput!): Product!
  deleteProduct(id: ID!): Boolean!
  createReview(input: CreateReviewInput!): Review!
  deleteReview(id: ID!): Boolean!
}

type Subscription {
  productUpdated(id: ID!): Product!
  reviewAdded(productId: ID!): Review!
}
