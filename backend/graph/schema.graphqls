# GraphQL Schema for Product Search API
# Demonstrates: Queries, Mutations, Pagination, Filtering, Custom Scalars

scalar DateTime

# ============== TYPES ==============

type Product {
  id: ID!
  name: String!
  description: String!
  price: Float!
  category: Category!
  imageUrl: String!
  stock: Int!
  rating: Float!
  reviewCount: Int!
  createdAt: DateTime!
  updatedAt: DateTime!
}

type Category {
  id: ID!
  name: String!
  slug: String!
  productCount: Int!
}

type Review {
  id: ID!
  productId: ID!
  userId: String!
  userName: String!
  rating: Int!
  comment: String!
  createdAt: DateTime!
}

# ============== PAGINATION (Cursor-based) ==============

type PageInfo {
  hasNextPage: Boolean!
  hasPreviousPage: Boolean!
  startCursor: String
  endCursor: String
  totalCount: Int!
}

type ProductEdge {
  cursor: String!
  node: Product!
}

type ProductConnection {
  edges: [ProductEdge!]!
  pageInfo: PageInfo!
}

type ReviewEdge {
  cursor: String!
  node: Review!
}

type ReviewConnection {
  edges: [ReviewEdge!]!
  pageInfo: PageInfo!
}

# ============== INPUTS ==============

input ProductFilterInput {
  search: String
  categoryId: ID
  minPrice: Float
  maxPrice: Float
  minRating: Float
  inStock: Boolean
}

input ProductSortInput {
  field: ProductSortField!
  order: SortOrder!
}

enum ProductSortField {
  NAME
  PRICE
  RATING
  CREATED_AT
}

enum SortOrder {
  ASC
  DESC
}

input CreateProductInput {
  name: String!
  description: String!
  price: Float!
  categoryId: ID!
  imageUrl: String!
  stock: Int!
}

input UpdateProductInput {
  name: String
  description: String
  price: Float
  categoryId: ID
  imageUrl: String
  stock: Int
}

input CreateReviewInput {
  productId: ID!
  rating: Int!
  comment: String!
}

# ============== QUERIES ==============

type Query {
  # Single product by ID
  product(id: ID!): Product

  # Paginated product search with filtering and sorting
  products(
    first: Int
    after: String
    last: Int
    before: String
    filter: ProductFilterInput
    sort: ProductSortInput
  ): ProductConnection!

  # Get all categories
  categories: [Category!]!

  # Get category by ID
  category(id: ID!): Category

  # Get reviews for a product
  reviews(
    productId: ID!
    first: Int
    after: String
  ): ReviewConnection!

  # Search suggestions (for autocomplete)
  searchSuggestions(query: String!, limit: Int): [String!]!
}

# ============== MUTATIONS ==============

type Mutation {
  # Product mutations
  createProduct(input: CreateProductInput!): Product!
  updateProduct(id: ID!, input: UpdateProductInput!): Product!
  deleteProduct(id: ID!): Boolean!

  # Review mutations
  createReview(input: CreateReviewInput!): Review!
  deleteReview(id: ID!): Boolean!
}

# ============== SUBSCRIPTIONS ==============

type Subscription {
  # Real-time product updates
  productUpdated(id: ID!): Product!

  # New review notifications
  reviewAdded(productId: ID!): Review!
}
