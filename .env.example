# ============================================================
# Environment Configuration
# Copy this file to .env and customize for your environment
# ============================================================

# --- Server ---
PORT=4000
APP_ENV=development        # development | staging | production

# --- Security ---
JWT_SECRET=your-super-secret-jwt-key-change-me-in-production
API_KEYS=                  # Comma-separated API keys for service-to-service auth

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Rate Limiting ---
RATE_LIMIT_RPS=100         # Requests per second per IP
RATE_LIMIT_BURST=200       # Maximum burst capacity

# --- GraphQL ---
MAX_QUERY_DEPTH=10         # Maximum query nesting depth
MAX_QUERY_COMPLEXITY=200   # Maximum query complexity score
MAX_PAGE_SIZE=100          # Maximum items per page
ENABLE_PLAYGROUND=true     # GraphQL Playground (disable in production)
ENABLE_INTROSPECTION=true  # Schema introspection (disable in production)

# --- HTTP Timeouts ---
READ_TIMEOUT=15s
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=30s
REQUEST_TIMEOUT=10s

# --- TLS (optional) ---
TLS_CERT_FILE=
TLS_KEY_FILE=

# --- Docker Compose ---
BACKEND_PORT=4000
FRONTEND_PORT=3000

# --- Database (uncomment when using PostgreSQL) ---
# DB_HOST=postgres
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=product_search
# DB_SSL_MODE=disable

# --- Redis (uncomment when using Redis) ---
# REDIS_URL=redis://redis:6379
